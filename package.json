{
  "name": "stock-maintainance-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:frontend": "npm install --prefix shopbill",
    "install:backend": "npm install --prefix shopbill/backend",
    "install:all": "npm install && npm run install:frontend && npm run install:backend",
    "dev:frontend": "npm run dev --prefix shopbill",
    "dev:backend": "npm run dev --prefix shopbill/backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix shopbill",
    "start:backend": "npm start --prefix shopbill/backend",
    "start": "npm run start:backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
